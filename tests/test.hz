A = {0.5, 0.76, 0.21, 0.66, 1.21, 4.01, 2.79, 0.95}
B = {0.43, 0.76, 0.21, 0.66, 1.21, 4.01, 2.79, 0.5}
C = {0.42, 0.76, 0.21, 0.66, 8, 4.01, 2.79, 0.95}

f(x, y, z) = (x + y) ^ 2 - y * z + 3

Tuples = A ⨉ B ⨉ C

Bases = {(a[0], a[1], a[2]) | a ∈ Tuples : f(a[0],a[1],a[2]) == 0}

